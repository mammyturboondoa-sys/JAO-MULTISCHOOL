# Copy this file to ".env" and edit it. Never share ".env" or commit it anywhere.
# Everything here is optional for local use.

PORT=3000
HOST=127.0.0.1

# Where the database and private uploads are stored.
# JAO_DATA_DIR=./data

# Set to 1 when the site is served over HTTPS (production).
# JAO_SECURE_COOKIES=1

# First-run sign-in emails (passwords are generated randomly and printed once).
# JAO_OWNER_EMAIL=owner@jao.local
# JAO_ADMIN_EMAIL=jao@seraphim.local

# DOUDOUS² AI (optional). Without these, DOUDOUS² answers from the approved
# knowledge base only and clearly says so. Put real values here, never in code.
# OPENAI_API_KEY=
# OPENAI_MODEL=

# New schools that register wait for the super administrator. Set to 1 to activate them instantly.
# JAO_AUTO_APPROVE_SCHOOLS=0

# ---- Hosting (only when running behind an HTTPS host such as Render) ----
# JAO_SECURE_COOKIES=1      cookies only over HTTPS, and HSTS header
# JAO_TRUST_PROXY=1         use the host's forwarded client address (needed for correct rate limits)
# JAO_FORCE_HTTPS=1         redirect http -> https (needs JAO_TRUST_PROXY=1)
# JAO_BACKUP_EVERY_HOURS=24 automatic backups (0 = off)    JAO_BACKUP_KEEP=14   how many to keep
